@namespace Hexalith.EventStore.Admin.UI.Components.Shared
@using Hexalith.EventStore.Admin.Abstractions.Security
@using Hexalith.EventStore.Admin.UI.Resources
@using System.Globalization
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<AdminResources> Text

<FluentCard role="note" aria-label="@Text["ConfirmationFactsLabel"]" Style="padding: 12px; margin-bottom: 12px;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
        <FluentText Weight="TextWeight.Semibold">@Text["ConfirmationTargetLabel"]</FluentText>
        <FluentText data-confirmation-fact="target">@ClampSupportSafe(Target)</FluentText>
        <FluentText Weight="TextWeight.Semibold">@Text["ConfirmationImpactLabel"]</FluentText>
        <FluentText data-confirmation-fact="impact">@ClampSupportSafe(Impact)</FluentText>
        <FluentText Weight="TextWeight.Semibold">@Text["ConfirmationPermissionLabel"]</FluentText>
        <FluentText data-confirmation-fact="permission">@ClampSupportSafe(RequiredPermission)</FluentText>
    </FluentStack>
</FluentCard>

@code {
    /// <summary>
    /// Gets or sets the support-safe target description.
    /// </summary>
    [Parameter, EditorRequired]
    public string Target { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the bounded impact description.
    /// </summary>
    [Parameter, EditorRequired]
    public string Impact { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the exact authorization level required to execute the action.
    /// </summary>
    [Parameter, EditorRequired]
    public string RequiredPermission { get; set; } = string.Empty;

    private const int MaxSupportSafeTextLength = 240;

    /// <summary>
    /// Determines whether a fact can be displayed without redaction or truncation.
    /// Confirmation handlers use this guard so the displayed target always matches execution.
    /// </summary>
    /// <param name="value">The fact value to validate.</param>
    /// <returns><see langword="true"/> when the value is support-safe and unchanged by rendering.</returns>
    public static bool IsExactAndSupportSafe(string? value) =>
        value is not null
        && value.Length <= MaxSupportSafeTextLength
        && !UnsafeMarkerDetection.ContainsUnsafeMarker(value)
        && !ContainsUnsafeDisplayCharacter(value);

    private static string ClampSupportSafe(string? value)
    {
        string text = value ?? string.Empty;
        if (UnsafeMarkerDetection.ContainsUnsafeMarker(text) || ContainsUnsafeDisplayCharacter(text))
        {
            return "[redacted]";
        }

        return text.Length <= MaxSupportSafeTextLength
            ? text
            : text[..(MaxSupportSafeTextLength - 3)] + "...";
    }

    private static bool ContainsUnsafeDisplayCharacter(string value)
    {
        foreach (System.Text.Rune rune in value.EnumerateRunes())
        {
            UnicodeCategory category = System.Text.Rune.GetUnicodeCategory(rune);
            if (category is UnicodeCategory.Control or UnicodeCategory.Format)
            {
                return true;
            }
        }

        return false;
    }
}
