<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableContainer>true</EnableContainer>
    <ContainerRepository>eventstore-admin</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.EventStore.Admin.Server\Hexalith.EventStore.Admin.Server.csproj" Condition="'$(HexalithUsePublishedSdkForHostedTests)' != 'true'" />
    <ProjectReference Include="..\Hexalith.EventStore.ServiceDefaults\Hexalith.EventStore.ServiceDefaults.csproj" Condition="'$(HexalithUsePublishedSdkForHostedTests)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- Explicit integration-fixture profile; ordinary native builds and publishing keep SDK source edges. -->
  <ItemGroup Condition="'$(HexalithUsePublishedSdkForHostedTests)' == 'true'">
    <PackageReference Include="Hexalith.EventStore.Admin.Server" />
    <PackageReference Include="Hexalith.EventStore.ServiceDefaults" />
  </ItemGroup>

</Project>
