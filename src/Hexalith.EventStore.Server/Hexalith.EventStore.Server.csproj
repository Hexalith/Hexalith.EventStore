<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Distributed event sourcing server for .NET — DAPR actor-based command processing,
      event persistence, and pub/sub for the Hexalith event store</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.EventStore" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Gateway" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Tests" />
    <InternalsVisibleTo Include="Hexalith.EventStore.IntegrationTests" />
    <InternalsVisibleTo Include="Hexalith.Parties.Tests" />
    <InternalsVisibleTo Include="Hexalith.Timesheets.IntegrationTests" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.LiveSidecar.Tests" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Testing" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Testing.Tests" />
    <InternalsVisibleTo Include="Hexalith.EventStore.CatalogConstruction" />
    <InternalsVisibleTo Include="Hexalith.EventStore.ProviderVerification" />
    <InternalsVisibleTo Include="Hexalith.EventStore.AppHost.Tests" />
    <!-- Dapr emits one named runtime assembly per internal actor proxy contract. -->
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Actors.IIdempotencyLegacySourceActor_.actorV1.proxy" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Actors.IIdempotencyLegacySourceActor_.actorV1.disp" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Actors.IIdempotencyTenantLifecycleMigrationActor_.actorV1.proxy" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Actors.IIdempotencyTenantLifecycleMigrationActor_.actorV1.disp" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Actors.IIdempotencyAdmissionDirectoryInspectionActor_.actorV1.proxy" />
    <InternalsVisibleTo Include="Hexalith.EventStore.Server.Actors.IIdempotencyAdmissionDirectoryInspectionActor_.actorV1.disp" />
    <!-- Required so NSubstitute (Castle.DynamicProxy) can generate dynamic proxies for
         internal interfaces such as IProjectionActorInvoker used as test seams. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.EventStore.Client\Hexalith.EventStore.Client.csproj" />
    <ProjectReference Include="..\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.EventStore.DomainService\Hexalith.EventStore.DomainService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Client" />
    <PackageReference Include="Dapr.Actors" />
    <PackageReference Include="Dapr.Actors.AspNetCore" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the unchanged normative core and hook in Server; the standalone codec/golden-test
         project intentionally remains nonpackable and must never become a NuGet dependency. -->
    <Compile Include="..\Hexalith.EventStore.PayloadProtection\*.cs" Link="Security\PayloadProtection\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="BindProtectionEngineSourceRevision" BeforeTargets="GenerateAssemblyInfo" DependsOnTargets="InitializeSourceControlInformation">
    <ItemGroup>
      <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>

</Project>
