<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Descriptor-only test fixtures for Platform-owned environments, bounded clients and support-safe diagnostics.</Description>
    <!-- This is test-support code (references xunit.v3 + Aspire.Hosting.Testing). xUnit1051 wants a
         TestContext cancellation token on framework calls; the harness probes/HTTP-polls with its
         own internal timeouts and runs outside a live test context during fixture startup. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.EventStore.Testing.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.EventStore.Testing\Hexalith.EventStore.Testing.csproj" />
    <ProjectReference Include="..\Hexalith.EventStore.Client\Hexalith.EventStore.Client.csproj" />
    <ProjectReference Include="..\Hexalith.EventStore.Server\Hexalith.EventStore.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Actors.AspNetCore" />
    <!-- Library that defines custom xUnit attributes/fixtures: use the extensibility core (not the
         full xunit.v3 metapackage, which requires an executable test project). Assert flows in
         transitively via the Hexalith.EventStore.Testing project reference. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

</Project>
