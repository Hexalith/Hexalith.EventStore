+    private static string CreateNuGetMetadata(string format, string name, string dependencyVersion = "1.2.3", string packageVersion = "1.2.3")
+    {
+        IsCredentialName(name).ShouldBeTrue("Each metadata fixture must reach credential detection.");
+        string contentHash = Convert.ToBase64String(new byte[64]);
+        if (format.StartsWith("lock", StringComparison.Ordinal))
+        {
+            int schema = format == "lock-v2" ? 2 : 1;
+            return $$$$$$"""{"version":{{{{{{schema}}}}}},"dependencies":{"net10.0":{"Example":{"type":"Transitive","resolved":"{{{{{{packageVersion}}}}}}","contentHash":"{{{{{{contentHash}}}}}}","dependencies":{"{{{{{{name}}}}}}":"{{{{{{dependencyVersion}}}}}}"}}}}}""";
+        }
+
+        if (format == "captured-deps")
+        {
+            return $$$$$$"""{"declaredTargets":{"net10.0":{"Example/{{{{{{packageVersion}}}}}}":{"dependencies":{"{{{{{{name}}}}}}":"{{{{{{dependencyVersion}}}}}}"}}}},"libraries":{"Example/{{{{{{packageVersion}}}}}}":{"type":"package"}}}""";
+        }
+
+        return $$$$$$"""{"version":3,"targets":{"net10.0":{"Example/{{{{{{packageVersion}}}}}}":{"type":"package","dependencies":{"{{{{{{name}}}}}}":"{{{{{{dependencyVersion}}}}}}"}}}}}""";
+    }
