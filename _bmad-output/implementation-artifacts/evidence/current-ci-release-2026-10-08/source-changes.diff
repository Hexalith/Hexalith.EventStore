+    private static bool IsNuGetMetadataOrJsonNull(string path, string content, int nameIndex, string name)
+    {
+        if (!path.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
+        {
+            return false;
+        }
+
+        try
+        {
+            // Parse the complete document first: an early matching token must not exempt malformed metadata.
+            using JsonDocument document = JsonDocument.Parse(content);
+            if (!HasUnambiguousJsonProperties(document.RootElement))
+            {
+                return false;
+            }
+
+            byte[] utf8 = Encoding.UTF8.GetBytes(content);
+            long targetIndex = Encoding.UTF8.GetByteCount(content.AsSpan(0, nameIndex));
+            var reader = new Utf8JsonReader(utf8);
+            var contexts = new Stack<(string? Name, long Start, JsonTokenType Type)>();
+            string? pendingProperty = null;
+            while (reader.Read())
+            {
+                if (reader.TokenType is JsonTokenType.StartObject or JsonTokenType.StartArray)
+                {
+                    contexts.Push((pendingProperty, reader.TokenStartIndex, reader.TokenType));
+                    pendingProperty = null;
+                }
+                else if (reader.TokenType is JsonTokenType.EndObject or JsonTokenType.EndArray)
+                {
+                    _ = contexts.Pop();
+                    pendingProperty = null;
+                }
+                else if (reader.TokenType == JsonTokenType.PropertyName)
+                {
+                    pendingProperty = reader.GetString();
+                    if (targetIndex < reader.TokenStartIndex || targetIndex > reader.BytesConsumed
+                        || !string.Equals(pendingProperty, name, StringComparison.Ordinal))
+                    {
+                        continue;
+                    }
+
+                    _ = reader.Read();
+                    if (reader.TokenType == JsonTokenType.Null)
+                    {
+                        return true;
+                    }
+
+                    (string? Name, long Start, JsonTokenType Type)[] parents = contexts.ToArray();
+                    if (reader.TokenType == JsonTokenType.String
+                        && IsNuGetDependencyRange(reader.GetString() ?? string.Empty)
+                        && IsNuGetPackageIdentity(name, versioned: false)
+                        && parents.Length >= 5 && parents[0].Name == "dependencies"
+                        && parents.Take(5).All(parent => parent.Type == JsonTokenType.StartObject))
+                    {
+                        using JsonDocument package = ReadJsonValueAt(utf8, parents[1].Start);
+                        bool assetsPackage = parents.Length >= 5 && parents[3].Name == "targets"
+                            && IsNuGetPackageIdentity(parents[1].Name, versioned: true)
+                            && HasJsonStringValue(package.RootElement, "type", "package")
+                            && IsNuGetLibraryDeclaration(utf8, parents[4].Start, parents[1].Name!, required: false)
+                            && (HasNuGetSchema(utf8, parents[4].Start, 3) || HasNuGetSchema(utf8, parents[4].Start, 4));
+                        bool capturedPackage = parents.Length >= 5 && parents[3].Name == "declaredTargets"
+                            && IsNuGetPackageIdentity(parents[1].Name, versioned: true)
+                            && IsNuGetLibraryDeclaration(utf8, parents[4].Start, parents[1].Name!, required: true);
+                        bool lockPackage = parents.Length >= 5 && parents[3].Name == "dependencies"
+                            && IsNuGetPackageIdentity(parents[1].Name, versioned: false)
+                            && IsNuGetLockPackage(package.RootElement)
+                            && (HasNuGetSchema(utf8, parents[4].Start, 1) || HasNuGetSchema(utf8, parents[4].Start, 2));
+                        return assetsPackage || capturedPackage || lockPackage;
+                    }
+
+                    if (reader.TokenType == JsonTokenType.StartObject
+                        && parents.Length >= 3 && parents[1].Name == "dependencies"
+                        && parents.Take(3).All(parent => parent.Type == JsonTokenType.StartObject)
+                        && IsNuGetPackageIdentity(name, versioned: false))
+                    {
+                        using JsonDocument lockRoot = ReadJsonValueAt(utf8, parents[2].Start);
+                        using JsonDocument package = JsonDocument.ParseValue(ref reader);
+                        return lockRoot.RootElement.TryGetProperty("version", out JsonElement version)
+                            && version.ValueKind == JsonValueKind.Number && version.TryGetInt32(out int schema) && schema is 1 or 2
+                            && IsNuGetLockPackage(package.RootElement);
+                    }
+
+                    return false;
+                }
+                else
+                {
+                    pendingProperty = null;
+                }
+            }
+        }
+        catch (JsonException)
+        {
