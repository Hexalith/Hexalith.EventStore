  "auditScript": "from pathlib import Path\nimport json,hashlib,datetime,xml.etree.ElementTree as E,collections\nroot=Path.cwd();base=root/'_bmad-output/implementation-artifacts/evidence/story-6-4';out=base/'qualification-20261017-parent'\ndef resolve(p):return Path(p) if Path(p).is_absolute() else root/p\ndef digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()\ndef refcheck(ref):\n p=resolve(ref['path']);assert digest(p)==ref['sha256'],p\n if 'bytes' in ref:assert p.stat().st_size==ref['bytes']\n return p\nrows=[]\nfor bp in sorted(base.glob('qualification-20261017-live-*-producer-binding.json')):\n b=json.loads(bp.read_text())\n for field in ['executionPacket','controlsPacket','fullVector','nativeVector','nativeXml','nativeLog']:refcheck(b[field])\n frame=json.loads(resolve(b['executionPacket']['path']).read_text());ctl=json.loads(resolve(b['controlsPacket']['path']).read_text());v=json.loads(resolve(b['fullVector']['path']).read_text());nv=json.loads(resolve(b['nativeVector']['path']).read_text());assert v['observations']==nv['observations']\n assert digest(resolve(ctl['nativeLog']))==ctl['nativeLogSha256']\n assert digest(resolve(b['nativeXml']['path']))==ctl['nativeXmlSha256']\n tests=list(E.parse(resolve(b['nativeXml']['path'])).iter('test'));counts=collections.Counter(t.attrib['result'] for t in tests)\n groups=[]\n for group in b['outputGroups']:\n  pp=refcheck(group['producerPacket']);producer=json.loads(pp.read_text());prefix=group['prefix'];consumed={k:v for k,v in frame['before']['runtime'].items() if k.startswith(prefix)}\n  available=group.get('consumedBeforeHashes')\n  if available is None:available={**group['baseAvailableInputs'],**group['nestedCapturedDirectoryInventory']}\n  assert consumed and consumed==available;assert all(producer['after']['runtime'].get(k)==v for k,v in consumed.items())\n  assert all(frame['after']['runtime'].get(k)==v for k,v in consumed.items())\n  groups.append({'prefix':prefix,'role':group['role'],'producerPacket':group['producerPacket'],'capturedInventoryFiles':len(consumed),'exactAfterProducerAndBeforeAfterExecutionSnapshotIdentityMatch':True,'consumptionAndFreshProductionClaimedForEveryInventoryFile':False,'interpretation':'Identity consistency of the runner-named inventory; nested publish/RID and dormant files may be inherited or unused. Concrete startup/copy inputs and native OQ8 receipt require separate supplemental bindings.'})\n current=[];tail=[]\n for obs in v['observations']:\n  val=obs['value'];cost=val.get('cost',{})\n  if obs['kind']=='ProjectionGuardCurrentMatrix':\n   h=val['head'];r=val['receiptLimit'];s=16384+80*h+512*min(h,r)\n   assert cost['SourceInspections']==2 and cost['ProofReads']==1 and cost['MarkerReads']==2\n   assert sum(cost[k] for k in ['SourceMetadataReads','ProofReads','MarkerReads','MetadataReads'])==11\n   assert sum(cost[k] for k in ['SourceMetadataBytes','ProofReadBytes','MarkerReadBytes','MetadataReadBytes'])<=s+114688\n   for key in ['SourceRanges','SourceReturnedEvents','SourceEventReads','HandlerAttempts','FoldAttempts','BatchExecutions','ModelMutations','ProofWriteAttempts','MutationAttempts','SchedulerWriteAttempts','Activations','ReplayPartUploadAttempts']:assert cost[key]==0\n   current.append({'head':h,'pageSize':val['pageSize'],'receiptLimit':r,'result':'pass'})\n  elif obs['kind']=='ProjectionGuardLiveCost' and val['delta']>0:\n   n=val['delta'];h=val['head'];r=val['receiptLimit'];q=val['pages'];s=16384+80*h+512*min(h,r)\n   assert cost['SourceInspections']<=3 and cost['SourceRanges']<=3*q and cost['SourceReturnedEvents']<=3*n\n   assert cost['HandlerAttempts']<=n and cost['BatchExecutions']<=n and cost['ModelMutations']<=2*n\n   assert cost['ProofReads']<=8 and cost['ProofWriteAttempts']<=4\n   assert cost['ProofReadBytes']<=8*s and cost['ProofWriteBytes']<=4*s and cost['ProofVisits']<=24*(h+min(h,r)+n)\n   tail.append({'head':h,'checkpoint':val['checkpoint'],'pageSize':val['pageSize'],'delta':n,'result':'pass'})\n direct=[]\n if b.get('oq8DirectInputs'):\n  oi=b['oq8DirectInputs'];ad=oi['additionalDeps'];assert frame['before']['runtime'][ad['path']]==ad['sha256']\n  for host,inputs in oi['hosts'].items():\n   prefix=inputs['sourceDirectory'].rstrip('/')+'/'\n   assert all(frame['before']['runtime'].get(prefix+name)==sha for name,sha in inputs['entryAndManifests'].items())\n   direct.append({'host':host,'sourceDirectory':inputs['sourceDirectory'],'entryAndManifests':inputs['entryAndManifests'],'baseStartupInputsMatchExecutionSnapshot':True,'expectedShadowRuntimeSetSha256':inputs['expectedShadowRuntimeSetSha256'],'nativeOQ8Evidence':b.get('oq8NativeEvidence'),'interpretation':'Expected copy/startup inputs do not establish host success or substitute for the native artifact receipt.'})\n row={'gate':b['gate'],'bindingPacket':{'path':str(bp.relative_to(root)),'sha256':digest(bp)},'nativeOutcomeCounts':dict(counts),'nativeCases':len(tests),'nativeExitCode':ctl['testExitCode'],'controlExitCodes':ctl['infrastructureExitCodes'],'controlsExitedCleanly':ctl['infrastructureExitCodes']==[0,0],'sourceInputChanges':len(frame['sourceInputsChanges']),'assetChanges':len(frame['assetsChanges']),'runtimeChanges':len(frame['runtimeChanges']),'producerGroups':groups,'directOQ8StartupInputs':direct,'currentRows':current,'tailRows':tail,'observationCounts':dict(collections.Counter(x['kind'] for x in v['observations']))}\n rows.append(row)\nrecord={'auditedUtc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'Independent parent checks completed Live packet/log/XML/vector identities, consistency of captured producer/execution output inventories and selected blocking Current/tail budgets. A file present unchanged after a producer is not thereby freshly produced or loaded; base startup and actual OQ8 copy receipts are distinct supplemental evidence. Other asserted source/wire/fallback modes remain owned by native tests and separate numerical audits. No whole-candidate acceptance inferred.','liveFrames':rows,'auditCommand':['python3','/tmp/story64_parent_live_audit.py'],'auditScriptSha256':digest(Path(__file__)),'auditScript':Path(__file__).read_text()}\n(out/'live-binding-and-budget-audit.json').write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps([{'gate':r['gate'],'nativeCases':r['nativeCases'],'currentRows':len(r['currentRows']),'tailRows':len(r['tailRows']),'controlsExitedCleanly':r['controlsExitedCleanly']} for r in rows],indent=2))\n"
