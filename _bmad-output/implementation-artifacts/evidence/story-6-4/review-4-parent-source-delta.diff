+        fixture.Rows.Values.ShouldAllBe(row => row.LastDeliveredSequence == 3 && row.ActiveReservation == null && row.IdleBindingPending == null);
+        fixture.Handlers.ShouldAllBe(handler => handler.Calls == 2 && handler.RebuildCalls == 0);
