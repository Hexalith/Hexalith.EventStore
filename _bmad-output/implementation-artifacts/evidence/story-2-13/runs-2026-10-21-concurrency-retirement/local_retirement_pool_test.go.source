// Isolated qualification of reference ownership and concurrent retirement.
package manager

import (
    "context"
    "sync"
    "sync/atomic"
    "testing"
    "time"

    "github.com/stretchr/testify/require"
    "google.golang.org/grpc"
)

func TestLocalRetirementSkipsNewLeasesAndDrainsExisting(t *testing.T) {
    pool := NewConnectionPool(time.Minute, 0)
    old := &retirementConnection{}
    pool.Register(old)
    first := pool.Share()
    second := pool.Share()
    require.Same(t, old, first)
    require.Same(t, old, second)
    pool.Retire(old)
    pool.Retire(old)
    require.Equal(t, int32(2), pool.connections[0].referenceCount, "retirement never consumes the caller's deferred release")
    require.Zero(t, old.closes.Load(), "active leases keep the retired channel open")
    require.Nil(t, pool.Share(), "a retired channel never receives a new lease")
    fresh := &retirementConnection{}
    next, err := pool.Get(func() (grpc.ClientConnInterface, error) { return fresh, nil })
    require.NoError(t, err)
    require.Same(t, fresh, next)
    pool.Release(first)
    require.Zero(t, old.closes.Load(), "one remaining lease still owns the old channel")
    pool.Release(second)
    require.Equal(t, int32(1), old.closes.Load(), "last release closes exactly once")
    pool.Retire(old)
    require.Equal(t, int32(1), old.closes.Load())
    require.Len(t, pool.connections, 1)
    require.Same(t, fresh, pool.connections[0].conn)
    pool.Release(next)
    pool.DestroyAll()
    require.Equal(t, int32(1), fresh.closes.Load())
}

func TestLocalRetirementIdleChannelClosesExactlyOnce(t *testing.T) {
    pool := NewConnectionPool(time.Minute, 0)
    conn := &retirementConnection{}
    pool.Register(conn)
    pool.Retire(conn)
    pool.Retire(conn)
    pool.Purge()
    require.Equal(t, int32(1), conn.closes.Load())
    require.Empty(t, pool.connections)
}

func TestLocalRetirementConcurrentReleaseAndAcquire(t *testing.T) {
    for range 50 {
        pool := NewConnectionPool(time.Minute, 0)
        old := &retirementConnection{}
        pool.Register(old)
        leases := make([]grpc.ClientConnInterface, 32)
        for index := range leases { leases[index] = pool.Share() }
        pool.Retire(old)
        fresh := &retirementConnection{}
        start := make(chan struct{})
        acquired := make(chan grpc.ClientConnInterface, 32)
        var group sync.WaitGroup
        for _, lease := range leases {
            group.Go(func() { <-start; pool.Release(lease) })
            group.Go(func() { <-start; pool.Retire(old) })
            group.Go(func() {
                <-start
                next, _ := pool.Get(func() (grpc.ClientConnInterface, error) { return fresh, nil })
                acquired <- next
            })
        }
        close(start)
        group.Wait()
        close(acquired)
        for next := range acquired {
            require.Same(t, fresh, next)
            pool.Release(next)
        }
        require.Equal(t, int32(1), old.closes.Load())
        require.Len(t, pool.connections, 1)
        require.Equal(t, int32(0), pool.connections[0].referenceCount)
        pool.DestroyAll()
        require.Equal(t, int32(1), fresh.closes.Load())
    }
}

type retirementConnection struct { closes atomic.Int32 }

func (c *retirementConnection) Close() error { c.closes.Add(1); return nil }
func (*retirementConnection) Invoke(context.Context, string, any, any, ...grpc.CallOption) error { return nil }
func (*retirementConnection) NewStream(context.Context, *grpc.StreamDesc, string, ...grpc.CallOption) (grpc.ClientStream, error) { return nil, nil }
