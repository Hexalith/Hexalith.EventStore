{
  "realm": "hexalith",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "attributes": {
    "CreateDefaultClientScopes": "true"
  },
  "clientScopes": [
    {
      "name": "eventstore-audience.sample",
      "description": "Story 5.5: grants the 'sample' domain-service audience to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sample",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "eventstore-audience.tenants",
      "description": "Story 5.5: grants the 'tenants' domain-service audience to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tenants",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "eventstore-operation.domain-service.process",
      "description": "Story 5.5: grants the 'domain-service:process' operation to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-operation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "eventstore:operation",
            "claim.value": "domain-service:process",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "eventstore-operation.domain-service.replay-state",
      "description": "Story 5.5: grants the 'domain-service:replay-state' operation to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-operation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "eventstore:operation",
            "claim.value": "domain-service:replay-state",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "eventstore-operation.domain-service.query",
      "description": "Story 5.5: grants the 'domain-service:query' operation to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-operation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "eventstore:operation",
            "claim.value": "domain-service:query",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "eventstore-operation.domain-service.project",
      "description": "Story 5.5: grants the 'domain-service:project' operation to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-operation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "eventstore:operation",
            "claim.value": "domain-service:project",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "eventstore-operation.domain-service.metadata",
      "description": "Story 5.5: grants the 'domain-service:metadata' operation to one EventStore workload token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workload-operation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "eventstore:operation",
            "claim.value": "domain-service:metadata",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "hexalith-eventstore",
      "name": "Hexalith EventStore",
      "description": "EventStore API client for E2E security testing (D11)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hexalith-eventstore",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenants-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenants",
            "claim.name": "eventstore:tenant",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "domains-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "domains",
            "claim.name": "eventstore:domain",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "permissions-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "permissions",
            "claim.name": "eventstore:permission",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "global-admin-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "global_admin",
            "claim.name": "global_admin",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hexalith-frontshell",
      "name": "Hexalith FrontShell",
      "description": "FrontShell SPA client (Authorization Code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hexalith-eventstore",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenants-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenants",
            "claim.name": "eventstore:tenant",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "domains-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "domains",
            "claim.name": "eventstore:domain",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "permissions-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "permissions",
            "claim.name": "eventstore:permission",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "global-admin-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "global_admin",
            "claim.name": "global_admin",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "eventstore",
      "name": "Hexalith EventStore workload",
      "description": "Service-account workload client: short-lived assertions proving EventStore to domain services (Story 5.5). Grants no audience or operation by default; each token is requested for one audience scope and one operation scope.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__HEXALITH_WORKLOAD_CLIENT_SECRET__",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": [
        "eventstore-audience.sample",
        "eventstore-audience.tenants",
        "eventstore-operation.domain-service.process",
        "eventstore-operation.domain-service.replay-state",
        "eventstore-operation.domain-service.query",
        "eventstore-operation.domain-service.project",
        "eventstore-operation.domain-service.metadata"
      ]
    }
  ],
  "users": [
    {
      "id": "__HEXALITH_ADMIN_USER_ID__",
      "username": "__HEXALITH_ADMIN_USERNAME__",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "email": "admin@hexalith.io",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__HEXALITH_ADMIN_PASSWORD__",
          "temporary": false
        }
      ],
      "attributes": {
        "tenants": ["tenant-a", "tenant-b", "system"],
        "domains": ["orders", "inventory", "counter"],
        "permissions": ["command:submit", "command:replay", "command:query"],
        "global_admin": ["true"]
      }
    },
    {
      "id": "__HEXALITH_TENANT_A_USER_ID__",
      "username": "tenant-a-user",
      "firstName": "Tenant",
      "lastName": "A",
      "enabled": true,
      "email": "tenant-a@hexalith.io",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__HEXALITH_TENANT_A_PASSWORD__",
          "temporary": false
        }
      ],
      "attributes": {
        "tenants": ["tenant-a"],
        "domains": ["counter"],
        "permissions": ["command:submit", "command:query"]
      }
    },
    {
      "id": "__HEXALITH_TENANT_B_USER_ID__",
      "username": "tenant-b-user",
      "firstName": "Tenant",
      "lastName": "B",
      "enabled": true,
      "email": "tenant-b@hexalith.io",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__HEXALITH_TENANT_B_PASSWORD__",
          "temporary": false
        }
      ],
      "attributes": {
        "tenants": ["tenant-b"],
        "domains": ["counter"],
        "permissions": ["command:submit"]
      }
    },
    {
      "id": "__HEXALITH_READ_ONLY_USER_ID__",
      "username": "readonly-user",
      "firstName": "Read",
      "lastName": "Only",
      "enabled": true,
      "email": "readonly@hexalith.io",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__HEXALITH_READ_ONLY_PASSWORD__",
          "temporary": false
        }
      ],
      "attributes": {
        "tenants": ["tenant-a"],
        "domains": ["counter"],
        "permissions": ["command:query"]
      }
    },
    {
      "id": "__HEXALITH_NO_TENANT_USER_ID__",
      "username": "no-tenant-user",
      "firstName": "No",
      "lastName": "Tenant",
      "enabled": true,
      "email": "no-tenant@hexalith.io",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__HEXALITH_NO_TENANT_PASSWORD__",
          "temporary": false
        }
      ],
      "attributes": {
        "tenants": [],
        "domains": ["counter"],
        "permissions": ["command:submit"]
      }
    }
  ]
}
