// Supplemental pinned-dependency probe; not part of the static-endpoint runtime proof.
package router_test

import (
	"context"
	"net"
	"runtime"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/stretchr/testify/require"
	"google.golang.org/grpc"
	_ "google.golang.org/grpc/balancer/roundrobin"
	"google.golang.org/grpc/connectivity"
	"google.golang.org/grpc/credentials/insecure"
	"google.golang.org/grpc/resolver"
	"google.golang.org/grpc/resolver/manual"
)

func TestPinnedResetConnectBackoffResolverChurn(t *testing.T) {
	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
	defer cancel()
	// Reserve exact loopback addresses, then close listeners so connection failures
	// stay local and keep the channel in the state that permits the candidate action.
	var listeners []net.Listener
	var addresses []resolver.Address
	for range 12 {
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		require.NoError(t, err)
		listeners = append(listeners, listener)
		addresses = append(addresses, resolver.Address{Addr: listener.Addr().String()})
	}
	for _, listener := range listeners {
		require.NoError(t, listener.Close())
	}
	builder := manual.NewBuilderWithScheme("story213-churn")
	builder.InitialState(resolver.State{Addresses: addresses[:6]})
	conn, err := grpc.NewClient("story213-churn:///target", grpc.WithResolvers(builder),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
		grpc.WithDefaultServiceConfig(`{"loadBalancingConfig":[{"round_robin":{}}]}`))
	require.NoError(t, err)
	defer conn.Close()
	conn.Connect()
	require.Eventually(t, func() bool { return conn.GetState() == connectivity.TransientFailure }, time.Second, time.Millisecond)
	var resets atomic.Int32
	var group sync.WaitGroup
	group.Add(1)
	go func() {
		defer group.Done()
		for ctx.Err() == nil {
			if conn.GetState() == connectivity.TransientFailure {
				conn.ResetConnectBackoff()
				resets.Add(1)
			}
			runtime.Gosched()
		}
	}()
	updates := 0
	for ctx.Err() == nil && updates < 2000 {
		start := (updates % 2) * 6
		builder.UpdateState(resolver.State{Addresses: addresses[start : start+6]})
		updates++
		time.Sleep(100 * time.Microsecond)
	}
	cancel()
	group.Wait()
	t.Logf("state-gated pinned ResetConnectBackoff calls=%d resolver updates=%d", resets.Load(), updates)
	require.Positive(t, resets.Load(), "probe must execute the candidate's state-gated API action")
}
