// Test-only overlapping RPC qualification of the pinned Dapr router.
package router

import (
	"context"
	"net"
	"sync/atomic"
	"testing"
	"time"

	"github.com/stretchr/testify/require"
	"google.golang.org/grpc"
	grpcbackoff "google.golang.org/grpc/backoff"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/connectivity"
	"google.golang.org/grpc/status"
	"google.golang.org/protobuf/types/known/emptypb"

	"github.com/dapr/dapr/pkg/actors/api"
	"github.com/dapr/dapr/pkg/api/grpc/manager"
	"github.com/dapr/dapr/pkg/modes"
	internalv1pb "github.com/dapr/dapr/pkg/proto/internals/v1"
	securityfake "github.com/dapr/dapr/pkg/security/fake"
)

func TestConcurrencyHealthyServerUnavailablePreservesOverlappingUsers(t *testing.T) {
	for _, kind := range []string{"actor", "reminder", "stream"} {
		t.Run(kind, func(t *testing.T) {
			ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
			defer cancel()
			sink := &concurrencySink{entered: make(chan string, 3), release: make(chan struct{}), cancelled: make(chan string, 3)}
			listener, err := net.Listen("tcp", "127.0.0.1:0")
			require.NoError(t, err)
			srv := grpc.NewServer()
			internalv1pb.RegisterServiceInvocationServer(srv, sink)
			go srv.Serve(listener)
			t.Cleanup(srv.Stop)
			mgr := manager.NewManager(securityfake.New(), modes.StandaloneMode, &manager.AppChannelConfig{})
			conn, release, err := mgr.GetGRPCConnection(ctx, listener.Addr().String(), "target", "default")
			require.NoError(t, err)
			defer conn.Close()
			release(false)
			conn.Connect()
			require.Eventually(t, func() bool { return conn.GetState() == connectivity.Ready }, time.Second, time.Millisecond)
			r := &router{grpc: mgr, namespace: "default"}
			target := &api.LookupActorResponse{Address: listener.Addr().String(), AppID: "target"}
			completed := make(chan error, 1)
			var deliveries atomic.Int32
			go func() {
				var callErr error
				switch kind {
				case "actor":
					_, callErr = r.callRemoteActor(ctx, target, concurrencyRequest("held"))
				case "reminder":
					callErr = r.callRemoteActorReminder(ctx, target, &api.Reminder{ActorType: "test-type", ActorID: "held", Name: "held"})
				case "stream":
					callErr = r.callRemoteActorStream(ctx, target, concurrencyRequest("held"), func(*internalv1pb.InternalInvokeResponse) (bool, error) {
						return deliveries.Add(1) == 2, nil
					})
				}
				completed <- callErr
			}()
			select {
			case entered := <-sink.entered:
				require.Equal(t, kind, entered)
			case <-ctx.Done():
				t.Fatal("held RPC never reached the healthy server")
			}
			if kind == "stream" {
				require.Eventually(t, func() bool { return deliveries.Load() == 1 }, time.Second, time.Millisecond)
			}
			t.Logf("overlap established: kind=%s state=%s address=%s", kind, conn.GetState(), target.Address)
			_, fault := r.callRemoteActor(ctx, target, concurrencyRequest("unavailable"))
			require.Equal(t, codes.Unavailable, status.Code(fault), "healthy server deliberately returns Unavailable")
			stateAfterFault := conn.GetState()
			close(sink.release)
			var heldErr error
			select {
			case heldErr = <-completed:
			case <-ctx.Done():
				t.Fatal("held RPC exceeded its original caller deadline")
			}
			next, teardown, err := mgr.GetGRPCConnection(ctx, target.Address, "target", "default")
			require.NoError(t, err)
			defer teardown(true)
			t.Logf("observed healthy-server Unavailable: held=%s result=%v stateAfterFault=%s samePooledChannel=%t streamMessages=%d", kind, heldErr, stateAfterFault, conn == next, deliveries.Load())
			// All observations above are retained even on the original candidate's failure.
			require.NoError(t, heldErr, "one server-returned Unavailable must not abort an independent active RPC")
			require.Same(t, conn, next)
			require.Equal(t, connectivity.Ready, stateAfterFault)
			select {
			case cancelled := <-sink.cancelled:
				t.Fatalf("healthy held %s server context was cancelled", cancelled)
			default:
			}
			if kind == "stream" {
				require.Equal(t, int32(2), deliveries.Load())
			}
		})
	}
}

func TestConcurrencyTransportFailureWakesSharedBackoff(t *testing.T) {
	ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
	defer cancel()
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	require.NoError(t, err)
	address := listener.Addr().String()
	require.NoError(t, listener.Close())
	mgr := manager.NewManager(securityfake.New(), modes.StandaloneMode, &manager.AppChannelConfig{})
	conn, release, err := mgr.GetGRPCConnection(ctx, address, "target", "default", grpc.WithConnectParams(grpc.ConnectParams{
		Backoff: grpcbackoff.Config{BaseDelay: time.Hour, Multiplier: 1, MaxDelay: time.Hour}, MinConnectTimeout: time.Second,
	}))
	require.NoError(t, err)
	defer conn.Close()
	release(false)
	conn.Connect()
	require.Eventually(t, func() bool { return conn.GetState() == connectivity.TransientFailure }, 3*time.Second, time.Millisecond)
	restored, err := net.Listen("tcp", address)
	require.NoError(t, err)
	srv := grpc.NewServer()
	internalv1pb.RegisterServiceInvocationServer(srv, &concurrencySink{})
	go srv.Serve(restored)
	t.Cleanup(srv.Stop)
	probe, err := net.DialTimeout("tcp", address, 250*time.Millisecond)
	require.NoError(t, err)
	require.NoError(t, probe.Close())
	r := &router{grpc: mgr, namespace: "default"}
	target := &api.LookupActorResponse{Address: address, AppID: "target"}
	started := time.Now()
	_, callErr := r.callRemoteActor(ctx, target, concurrencyRequest("transport-control"))
	require.Equal(t, codes.Unavailable, status.Code(callErr), "the first failed transport attempt stays visible")
	require.Eventually(t, func() bool { return conn.GetState() == connectivity.Ready || conn.GetState() == connectivity.Shutdown }, time.Second, time.Millisecond)
	t.Logf("post-transport recovery state=%s elapsed=%s", conn.GetState(), time.Since(started))
	require.Equal(t, connectivity.Ready, conn.GetState(), "recover in place without destroying the shared ClientConn")
	next, teardown, err := mgr.GetGRPCConnection(ctx, address, "target", "default")
	require.NoError(t, err)
	defer teardown(true)
	require.Same(t, conn, next)
	_, err = r.callRemoteActor(ctx, target, concurrencyRequest("transport-control"))
	require.NoError(t, err)
}

func TestConcurrencyCancelledUnavailableDoesNotWakeBackoff(t *testing.T) {
	ctx, cancel := context.WithCancel(t.Context())
	defer cancel()
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	require.NoError(t, err)
	address := listener.Addr().String()
	require.NoError(t, listener.Close())
	var dials atomic.Int32
	redialled := make(chan struct{}, 1)
	mgr := manager.NewManager(securityfake.New(), modes.StandaloneMode, &manager.AppChannelConfig{})
	interceptor := func(callCtx context.Context, method string, req, reply any, cc *grpc.ClientConn, invoke grpc.UnaryInvoker, opts ...grpc.CallOption) error {
		if req.(*internalv1pb.InternalInvokeRequest).GetActor().GetActorId() == "cancel-unavailable" {
			cancel()
			return status.Error(codes.Unavailable, "controlled caller cancellation before recovery action")
		}
		return invoke(callCtx, method, req, reply, cc, opts...)
	}
	conn, release, err := mgr.GetGRPCConnection(t.Context(), address, "target", "default",
		grpc.WithUnaryInterceptor(interceptor),
		grpc.WithContextDialer(func(ctx context.Context, address string) (net.Conn, error) {
			if dials.Add(1) > 1 {
				select {
				case redialled <- struct{}{}:
				default:
				}
			}
			return (&net.Dialer{}).DialContext(ctx, "tcp", address)
		}),
		grpc.WithConnectParams(grpc.ConnectParams{Backoff: grpcbackoff.Config{BaseDelay: time.Hour, Multiplier: 1, MaxDelay: time.Hour}, MinConnectTimeout: time.Second}))
	require.NoError(t, err)
	defer conn.Close()
	release(false)
	conn.Connect()
	require.Eventually(t, func() bool { return conn.GetState() == connectivity.TransientFailure }, time.Second, time.Millisecond)
	r := &router{grpc: mgr, namespace: "default"}
	_, err = r.callRemoteActor(ctx, &api.LookupActorResponse{Address: address, AppID: "target"}, concurrencyRequest("cancel-unavailable"))
	require.Equal(t, codes.Unavailable, status.Code(err))
	select {
	case <-redialled:
		t.Fatal("cancelled Unavailable must not reset another caller's shared backoff")
	case <-time.After(200 * time.Millisecond):
	}
	require.Equal(t, connectivity.TransientFailure, conn.GetState())
	require.Equal(t, int32(1), dials.Load())
}

func concurrencyRequest(id string) *internalv1pb.InternalInvokeRequest {
	return &internalv1pb.InternalInvokeRequest{Actor: &internalv1pb.Actor{ActorType: "test-type", ActorId: id}}
}

type concurrencySink struct {
	internalv1pb.UnimplementedServiceInvocationServer
	entered   chan string
	release   chan struct{}
	cancelled chan string
}

func (s *concurrencySink) hold(ctx context.Context, kind string) error {
	s.entered <- kind
	select {
	case <-s.release:
		return nil
	case <-ctx.Done():
		s.cancelled <- kind
		return ctx.Err()
	}
}

func (s *concurrencySink) CallActor(ctx context.Context, req *internalv1pb.InternalInvokeRequest) (*internalv1pb.InternalInvokeResponse, error) {
	if req.GetActor().GetActorId() == "unavailable" {
		return nil, status.Error(codes.Unavailable, "healthy-server-controlled-Unavailable")
	}
	if req.GetActor().GetActorId() == "held" {
		if err := s.hold(ctx, "actor"); err != nil {
			return nil, err
		}
	}
	return &internalv1pb.InternalInvokeResponse{}, nil
}

func (s *concurrencySink) CallActorReminder(ctx context.Context, _ *internalv1pb.Reminder) (*emptypb.Empty, error) {
	if err := s.hold(ctx, "reminder"); err != nil {
		return nil, err
	}
	return &emptypb.Empty{}, nil
}

func (s *concurrencySink) CallActorStream(_ *internalv1pb.InternalInvokeRequest, stream internalv1pb.ServiceInvocation_CallActorStreamServer) error {
	if err := stream.Send(&internalv1pb.InternalInvokeResponse{}); err != nil {
		return err
	}
	if err := s.hold(stream.Context(), "stream"); err != nil {
		return err
	}
	return stream.Send(&internalv1pb.InternalInvokeResponse{})
}
