
func TestReviewCanceledUnavailableRetainsChannel(t *testing.T) {
    listener, err := net.Listen("tcp", "127.0.0.1:0")
    require.NoError(t, err)
    srv := grpc.NewServer()
    go srv.Serve(listener)
    t.Cleanup(srv.Stop)
    ctx, cancel := context.WithCancel(t.Context())
    defer cancel()
    mgr := manager.NewManager(securityfake.New(), modes.StandaloneMode, &manager.AppChannelConfig{})
    interceptor := func(_ context.Context, _ string, _, _ any, _ *grpc.ClientConn, _ grpc.UnaryInvoker, _ ...grpc.CallOption) error {
        cancel()
        return status.Error(codes.Unavailable, "transport outcome races with caller cancellation")
    }
    conn, release, err := mgr.GetGRPCConnection(t.Context(), listener.Addr().String(), "target", "default", grpc.WithUnaryInterceptor(interceptor))
    require.NoError(t, err)
    defer conn.Close()
    release(false)
    conn.Connect()
    require.Eventually(t, func() bool { return conn.GetState() == connectivity.Ready }, time.Second, time.Millisecond)
    _, err = newLocalRecoveryRouter(mgr, listener.Addr().String()).Call(ctx, &internalv1pb.InternalInvokeRequest{Actor: &internalv1pb.Actor{ActorType:"test-type", ActorId:"cancel-unavailable"}})
    require.Error(t, err)
    next, teardown, err := mgr.GetGRPCConnection(t.Context(), listener.Addr().String(), "target", "default")
    require.NoError(t, err)
    defer teardown(true)
    require.Same(t, conn, next, "Unavailable returned after cancellation must retain the shared channel")
}
