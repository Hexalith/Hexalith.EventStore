// Local cancellation controls for the isolated ordinary remote-actor patch.
package router_test

import (
	"context"
	"net"
	"testing"
	"time"

	"github.com/stretchr/testify/require"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/connectivity"
	"google.golang.org/grpc/status"

	"github.com/dapr/dapr/pkg/api/grpc/manager"
	"github.com/dapr/dapr/pkg/modes"
	internalv1pb "github.com/dapr/dapr/pkg/proto/internals/v1"
	securityfake "github.com/dapr/dapr/pkg/security/fake"
)

func TestLocalEvaluationCallerCancellationRetainsChannel(t *testing.T) {
	for _, deadline := range []bool{false, true} {
		name := "cancel"
		if deadline {
			name = "deadline"
		}
		t.Run(name, func(t *testing.T) {
			listener, err := net.Listen("tcp", "127.0.0.1:0")
			require.NoError(t, err)
			entered := make(chan struct{}, 1)
			srv := grpc.NewServer()
			internalv1pb.RegisterServiceInvocationServer(srv, &localCancellationSink{entered: entered})
			go srv.Serve(listener)
			t.Cleanup(srv.Stop)
			mgr := manager.NewManager(securityfake.New(), modes.StandaloneMode, &manager.AppChannelConfig{})
			conn, release, err := mgr.GetGRPCConnection(t.Context(), listener.Addr().String(), "target", "default")
			require.NoError(t, err)
			defer conn.Close()
			release(false)
			conn.Connect()
			require.Eventually(t, func() bool { return conn.GetState() == connectivity.Ready }, time.Second, time.Millisecond)
			var ctx context.Context
			var cancel context.CancelFunc
			if deadline {
				ctx, cancel = context.WithTimeout(t.Context(), 200*time.Millisecond)
			} else {
				ctx, cancel = context.WithCancel(t.Context())
			}
			defer cancel()
			completed := make(chan error, 1)
			started := time.Now()
			go func() {
				_, callErr := newLocalRecoveryRouter(mgr, listener.Addr().String()).Call(ctx, &internalv1pb.InternalInvokeRequest{Actor: &internalv1pb.Actor{ActorType: "test-type", ActorId: "cancellation-control"}})
				completed <- callErr
			}()
			select {
			case <-entered:
			case <-time.After(time.Second):
				t.Fatal("remote actor was not entered")
			}
			if !deadline {
				cancel()
			}
			select {
			case callErr := <-completed:
				require.Error(t, callErr)
				require.ErrorIs(t, callErr, ctx.Err(), "the router preserves the caller's cancellation cause")
				t.Logf("bounded caller cancellation result: %v", callErr)
			case <-time.After(time.Second):
				t.Fatal("caller budget did not bound remote invocation")
			}
			require.Less(t, time.Since(started), time.Second)
			next, teardown, err := mgr.GetGRPCConnection(t.Context(), listener.Addr().String(), "target", "default")
			require.NoError(t, err)
			defer teardown(true)
			require.Same(t, conn, next, "cancellation must not destroy a healthy shared channel")
			t.Log("caller cancellation bounded the invocation without evicting the shared channel")
		})
	}
}

type localCancellationSink struct {
	internalv1pb.UnimplementedServiceInvocationServer
	entered chan<- struct{}
}

func (s *localCancellationSink) CallActor(ctx context.Context, _ *internalv1pb.InternalInvokeRequest) (*internalv1pb.InternalInvokeResponse, error) {
	s.entered <- struct{}{}
	<-ctx.Done()
	return nil, status.Error(codes.Unavailable, "local-controlled-cancellation")
}
