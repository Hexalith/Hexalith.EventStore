namespace Hexalith.EventStore.PayloadProtection;

/// <summary>Actual loaded engine binary identity. Qualification must bind the binary to its accepted full canonical source target independently.</summary>
/// <param name="Name">Loaded assembly name.</param>
/// <param name="Version">Loaded assembly version.</param>
/// <param name="InformationalVersion">Build informational version, including source revision when supplied by the build.</param>
/// <param name="SourceRevision">Exact compiled source revision; empty means the build cannot establish the source target.</param>
public sealed record InteractionProtectionEngineIdentity(string Name, string Version, string InformationalVersion, string SourceRevision);
