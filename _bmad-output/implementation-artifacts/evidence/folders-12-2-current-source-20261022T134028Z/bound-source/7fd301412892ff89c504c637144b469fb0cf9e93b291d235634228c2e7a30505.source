            __builder.AddMarkupContent(23, "<h2>Recommended Learning Order</h2>\n");
            __builder.AddMarkupContent(24, @"<ol><li><strong><a href=""/pattern-silent-reload"">Pattern 2: Silent Reload</a></strong> —
        Simplest (~20 lines). Data re-queries automatically on received signals with debounce.
        Start here for immediate gratification.
    </li>
    <li><strong><a href=""/pattern-notification"">Pattern 1: Notification</a></strong> —
        Adds user control. A persistent message bar prompts the user to refresh when
        data changes. No layout shifts until user acts.
    </li>
    <li><strong><a href=""/pattern-selective-refresh"">Pattern 3: Selective Refresh</a></strong> —
        Most sophisticated. Each component manages its own subscription and refreshes
        independently. Best UX but more implementation effort.
    </li></ol>

");
