namespace Hexalith.EventStore.Client.Projections;

/// <summary>Closed, identity-free categories measured at the owning projection protocol seams.</summary>
internal enum ProjectionDeliveryCost
{
    SourceInspections, SourceRanges, SourceMetadataReads, SourceMetadataBytes,
    SourceEventReads, SourceDeserializations, SourceDeserializationBytes,
    SourceSizingBytes, SourceResponses, SourceResponseBytes, SourceReturnedEvents,
    SourceLookaheadEvents, SourceLookaheadBytes, SourceEventHashes, SourceChainExtensions,
    RouteEventHashes, WireEvents, WireBytes, ProofReads, ProofReadBytes, ProofWriteAttempts,
    ProofWriteBytes, MarkerReads, MarkerReadBytes, ProofVisits, MetadataReads, MetadataReadBytes,
    MutationAttempts, MutationBytes, StateRpcAttempts, TransactionAttempts,
    HandlerAttempts, FoldAttempts, BatchExecutions, ModelMutations, ModelBytes,
    SchedulerScans, SchedulerShardReads, SchedulerEntries, SchedulerReadBytes,
    SchedulerWriteAttempts, SchedulerWriteBytes, SchedulerCasAttempts, Activations,
    SourceResponseSerializationBytes, SourceResponseDeserializationBytes,
    MetadataSizingBytes, ProofParsingBytes, ProofSerializationBytes,
    ManifestOperations,
    RetryActivations,
    WireReadabilityAttempts, WireReadabilityInputBytes, WireUnprotectionAttempts,
    WireDecodedEvents, WireDecodedPayloadBytes, WireSizingBytes,
    GuardActivationAttempts, WriterActivationAttempts, ReconciliationReads, ReconciliationWrites,
    MetadataSerializationBytes,
    ManifestSerializationBytes,
    SourceBootstrapAttempts, BootstrapStateReads, SourceAnchorWriteAttempts,
    SourceAnchorWriteBytes, SourceAnchorReadbacks, BootstrapSaveAttempts,
    ReplayTransportSerializationBytes, ReplayPartUploadAttempts, ReplayPartUploadBytes,
    ActivationScans, ActivationShardReads, ActivationEntries, ActivationReadBytes,
    ActivationWriteAttempts, ActivationWriteBytes,
    WireTransportSerializationBytes,
    WireStreamingFallbacks,
    ReplayRequestDigestSerializationBytes,
    SchedulerMigrationReads, SchedulerMigrationReadBytes, SchedulerMigrationEntries,
    SchedulerMigrationWrites, SchedulerMigrationWriteBytes,
}
