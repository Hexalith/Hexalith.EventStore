+using Hexalith.EventStore.Extensions;
+using Hexalith.EventStore.Server.Actors;
+using Hexalith.EventStore.ServiceDefaults.Authentication;
+
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.AspNetCore.Routing.Patterns;
+using Microsoft.AspNetCore.TestHost;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.Extensions.Hosting;
+
+using Shouldly;
+
+namespace Hexalith.EventStore.Server.Tests.Configuration;
+
+/// <summary>Proves custom SDK hosts using Dapr's original mapper receive actor isolation without private metadata.</summary>
+public sealed class CustomHostActorCallbackRateLimitTests
+{
+    [Fact]
+    public async Task RawDaprMappingUsesTrustedDelegateProvenanceForIndependentBoundedQuotasAsync()
+    {
+        const string ChannelToken = "custom-host-channel-token";
+        WebApplicationBuilder builder = WebApplication.CreateBuilder(new WebApplicationOptions { EnvironmentName = Environments.Development });
+        builder.WebHost.UseTestServer();
+        // Unused controller/command services are outside this minimal mapping-only host.
+        builder.Host.UseDefaultServiceProvider(options => options.ValidateOnBuild = false);
+        builder.Configuration.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            [DaprAppChannelToken.ConfigurationKey] = ChannelToken,
+            ["Authentication:JwtBearer:Issuer"] = "custom-host-fixture",
+            ["Authentication:JwtBearer:Audience"] = "hexalith-eventstore",
+            ["Authentication:JwtBearer:SigningKey"] = "custom-host-test-signing-key-at-least-32-bytes",
+            ["Authentication:JwtBearer:RequireHttpsMetadata"] = "false",
+            ["EventStore:RateLimiting:PermitLimit"] = "2",
+            ["EventStore:RateLimiting:ConsumerPermitLimit"] = "2",
+            ["EventStore:RateLimiting:SegmentsPerWindow"] = "1",
+            ["EventStore:RateLimiting:ConsumerSegmentsPerWindow"] = "1",
+            ["EventStore:RateLimiting:ConsumerWindowSeconds"] = "60",
+        });
+        builder.Services.AddEventStore();
+        builder.Services.AddActors(options => options.Actors.RegisterActor<IdempotencyAdmissionActor>());
+        // This custom host exercises HTTP mapping and middleware only; it owns no application background workers.
+        builder.Services.RemoveAll<IHostedService>();
+        await using WebApplication app = builder.Build();
+        app.UseAuthentication();
+        app.UseRateLimiter();
+        app.UseAuthorization();
+        app.MapActorsHandlers();
+        await app.StartAsync(TestContext.Current.CancellationToken);
+        using HttpClient client = app.GetTestClient();
+        client.DefaultRequestHeaders.Add(DaprAppChannelToken.HeaderName, ChannelToken);
+        using HttpResponseMessage first = await client.DeleteAsync("/actors/IdempotencyAdmissionActor/custom-a");
+        using HttpResponseMessage second = await client.DeleteAsync("/actors/IdempotencyAdmissionActor/custom-a");
+        using HttpResponseMessage saturated = await client.DeleteAsync("/actors/IdempotencyAdmissionActor/custom-a");
+        using HttpResponseMessage other = await client.DeleteAsync("/actors/IdempotencyAdmissionActor/custom-b");
+        first.StatusCode.ShouldBe(System.Net.HttpStatusCode.OK);
+        second.StatusCode.ShouldBe(System.Net.HttpStatusCode.OK);
+        saturated.StatusCode.ShouldBe(System.Net.HttpStatusCode.TooManyRequests);
+        other.StatusCode.ShouldBe(System.Net.HttpStatusCode.OK);
+
+        RouteEndpoint[] genuine = ((IEndpointRouteBuilder)app).DataSources.SelectMany(source => source.Endpoints)
+            .OfType<RouteEndpoint>().Where(endpoint => endpoint.RoutePattern.Parameters.Any(parameter => parameter.Name == "actorId")).ToArray();
+        genuine.Length.ShouldBe(4);
+        var context = new DefaultHttpContext { RequestServices = app.Services };
+        context.Request.RouteValues["actorTypeName"] = "IdempotencyAdmissionActor";
+        context.Request.RouteValues["actorId"] = "custom-c";
+        foreach (RouteEndpoint endpoint in genuine)
+        {
+            endpoint.Metadata.GetMetadata<EventStoreActorCallbackEndpointMetadata>().ShouldBeNull();
+            context.Request.Method = endpoint.Metadata.GetMetadata<HttpMethodMetadata>()!.HttpMethods.Single();
+            context.Request.Headers[DaprAppChannelToken.HeaderName] = ChannelToken;
+            context.SetEndpoint(endpoint);
+            EventStoreRateLimitPartition.TrustedActorKey(context).ShouldNotBeNull();
+            context.Request.Headers.Remove(DaprAppChannelToken.HeaderName);
+            EventStoreRateLimitPartition.TrustedActorKey(context).ShouldBeNull();
+            context.Request.Headers[DaprAppChannelToken.HeaderName] = ChannelToken;
+            context.SetEndpoint(new RouteEndpoint(_ => Task.CompletedTask,
+                RoutePatternFactory.Parse(endpoint.RoutePattern.RawText!), endpoint.Order, endpoint.Metadata, endpoint.DisplayName));
+            EventStoreRateLimitPartition.TrustedActorKey(context).ShouldBeNull();
+        }
+    }
+}
diff --git a/tools/tests/test_qualify_internal_actor_admission.py b/tools/tests/test_qualify_internal_actor_admission.py
new file mode 100644
index 000000000..0748372c3
--- /dev/null
+++ b/tools/tests/test_qualify_internal_actor_admission.py
@@ -0,0 +1,131 @@
+"""Focused failure-injection controls for the owned process qualifier; no shared infrastructure is used."""
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+SCRIPT = Path(__file__).resolve().parents[1] / "qualify-internal-actor-admission.py"
+SPEC = importlib.util.spec_from_file_location("admission_runner", SCRIPT)
+RUNNER = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(RUNNER)
+
+
+class ActorAdmissionRunnerTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.root = Path(self.directory.name)
+        self.run = RUNNER.Qualification(argparse.Namespace(evidence=str(self.root / "evidence"), runtime=None))
+
+    def tearDown(self):
+        shutil.rmtree(self.run.runtime, ignore_errors=True)
+        self.directory.cleanup()
+
+    def fake_docker(self, *, absent=None, failed_remove=None):
+        calls = []
+        ids = {name: identity for name, identity in self.run.containers}
+
+        def invoke(*argv, **kwargs):
+            calls.append(argv)
+            if argv[1:3] == ("container", "inspect"):
+                name = argv[3]
+                if name == absent:
+                    return subprocess.CompletedProcess(argv, 1, "", "No such object")
+                value = [{"Id": ids[name], "Config": {"Labels": {"hexalith.qualification.run-id": self.run.run_id}}}]
+                return subprocess.CompletedProcess(argv, 0, json.dumps(value), "")
+            if argv[1] == "rm":
+                return subprocess.CompletedProcess(argv, int(argv[-1] == failed_remove), "", "")
+            if argv[1:3] == ("container", "ls"):
+                name = argv[6].removeprefix("name=^/").removesuffix("$")
+                return subprocess.CompletedProcess(argv, 0, ids[name] if ids[name] == failed_remove else "", "")
+            raise AssertionError(argv)
+
+        self.run.run = invoke
+        return calls
+
+    def test_verified_already_absent_container_does_not_skip_other_cleanup(self):
+        first, second = self.run.run_id + "-first", self.run.run_id + "-second"
+        self.run.containers = [(first, "a" * 64), (second, "b" * 64)]
+        calls = self.fake_docker(absent=second)
+        self.assertTrue(self.run.cleanup())
+        self.assertIn(("docker", "rm", "-f", "a" * 64), calls)
+        receipt = json.loads((self.run.out / "cleanup.json").read_text())
+        self.assertEqual(2, len(receipt["containers"]))
+        self.assertTrue(all(value["absent"] for value in receipt["containers"]))
+
+    def test_failed_removal_does_not_skip_other_resources_or_pass_cleanup(self):
+        first, second = self.run.run_id + "-first", self.run.run_id + "-second"
+        self.run.containers = [(first, "a" * 64), (second, "b" * 64)]
+        calls = self.fake_docker(failed_remove="b" * 64)
+        self.assertFalse(self.run.cleanup())
+        self.assertIn(("docker", "rm", "-f", "a" * 64), calls)
+        self.assertIn(("docker", "rm", "-f", "b" * 64), calls)
+        receipt = json.loads((self.run.out / "cleanup.json").read_text())
+        self.assertFalse(receipt["passed"])
+        self.assertTrue(receipt["runtime_absent"])
+
+    def test_qualification_cannot_report_success_when_cleanup_fails(self):
+        self.run.setup = lambda: None
+        self.run.qualify = lambda: None
+        self.run.cleanup = lambda: False
+        with patch.object(RUNNER, "Qualification", return_value=self.run), \
+                patch.object(sys, "argv", [str(SCRIPT), "--evidence", "unused"]), \
+                patch.object(RUNNER.signal, "signal"), patch.object(RUNNER.threading, "Thread"):
+            self.assertEqual(1, RUNNER.main())
+        result = json.loads((self.run.out / "result.json").read_text())
+        self.assertTrue(result["qualification_passed"])
+        self.assertFalse(result["cleanup_passed"])
+        self.assertFalse(result["passed"])
+
+    def test_sigterm_and_owner_loss_cleanup_owned_child_processes(self):
+        # Exercise real signals/processes without launching Redis/Dapr: the unchanged cleanup path
+        # must reap an independently launched child on both cancellation and test-runner loss.
+        harness = self.root / "harness.py"
+        harness.write_text(
+            "import importlib.util,os,sys,time\n"
+            f"s=importlib.util.spec_from_file_location('runner',{str(SCRIPT)!r})\n"
+            "m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\n"
+            "def setup(self):\n"
+            " self.launch('owned-child',[sys.executable,'-c','import time;time.sleep(60)'],os.environ.copy(),self.runtime)\n"
+            "m.Qualification.setup=setup\n"
+            "m.Qualification.qualify=lambda self:time.sleep(60)\n"
+            "raise SystemExit(m.main())\n")
+        for mode in ["signal", "owner-loss"]:
+            owner = subprocess.Popen([sys.executable, "-c", "import time;time.sleep(60)"])
+            evidence = self.root / mode
+            process = subprocess.Popen([sys.executable, str(harness), "--evidence", str(evidence), "--owner-pid", str(owner.pid)])
+            try:
+                deadline = time.monotonic() + 10
+                while not (evidence / "processes.json").exists() and time.monotonic() < deadline:
+                    time.sleep(0.05)
+                child = json.loads((evidence / "processes.json").read_text())[0]["pid"]
+                if mode == "signal":
+                    process.terminate()
+                else:
+                    owner.terminate()
+                    owner.wait(timeout=5)
+                self.assertEqual(1, process.wait(timeout=20))
+                result = json.loads((evidence / "result.json").read_text())
+                self.assertFalse(result["qualification_passed"])
+                self.assertTrue(result["cleanup_passed"])
+                self.assertFalse(result["passed"])
+                with self.assertRaises(ProcessLookupError):
+                    os.kill(child, 0)
+            finally:
+                if process.poll() is None:
+                    process.terminate()
+                    process.wait(timeout=20)
+                if owner.poll() is None:
+                    owner.terminate()
+                owner.wait(timeout=5)
+
+
+if __name__ == "__main__":
+    unittest.main()
