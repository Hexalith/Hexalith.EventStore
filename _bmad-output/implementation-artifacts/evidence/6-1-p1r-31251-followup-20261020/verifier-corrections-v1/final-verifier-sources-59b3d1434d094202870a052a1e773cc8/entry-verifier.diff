+            worker.record(['dotnet', '/Probe.dll', 'actor', 'http://127.0.0.1:12345', tenant, 'fixture', str(expected), kind],
+                          worker.scratch, executor.stamp(), 0, output)
+            return result
+        worker.actor = mock.Mock(side_effect=actor)
+        return worker
