<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup></PropertyGroup>
  <ItemGroup><Compile Include="../PublishedIdentity.cs" Link="PublishedIdentity.cs" /></ItemGroup>
  <ItemGroup Condition="'$(UseCurrentSource)' == 'true' or '$(EventStoreVersion)' == '3.119.0' or '$(EventStoreVersion)' == '3.121.0' or '$(EventStoreVersion)' == '3.122.1' or '$(EventStoreVersion)' == '3.125.0' or '$(EventStoreVersion)' == '3.125.1'">
    <Compile Include="../domain/FixtureEvolutionManifest.cs" Link="FixtureEvolutionManifest.cs" />
    <Content Include="../domain/fixture-evolution-manifest.json" Link="fixture-evolution-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCurrentSource)' == 'true' or '$(EventStoreVersion)' == '3.121.0' or '$(EventStoreVersion)' == '3.122.1' or '$(EventStoreVersion)' == '3.125.0' or '$(EventStoreVersion)' == '3.125.1'">
    <Compile Include="../FixtureSnapshotQualification.cs" Link="FixtureSnapshotQualification.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCurrentSource)' != 'true'">
    <PackageReference Include="Hexalith.EventStore.Client" />
    <PackageReference Include="Hexalith.EventStore.Contracts" />
    <PackageReference Include="Hexalith.EventStore.DomainService" />
    <PackageReference Include="Hexalith.EventStore.Server" />
    <PackageReference Include="Hexalith.EventStore.ServiceDefaults" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCurrentSource)' == 'true'">
    <ProjectReference Include="$(EventStoreSourceRoot)/src/Hexalith.EventStore.Client/Hexalith.EventStore.Client.csproj" />
    <ProjectReference Include="$(EventStoreSourceRoot)/src/Hexalith.EventStore.Contracts/Hexalith.EventStore.Contracts.csproj" />
    <ProjectReference Include="$(EventStoreSourceRoot)/src/Hexalith.EventStore.DomainService/Hexalith.EventStore.DomainService.csproj" />
    <ProjectReference Include="$(EventStoreSourceRoot)/src/Hexalith.EventStore.Server/Hexalith.EventStore.Server.csproj" />
    <ProjectReference Include="$(EventStoreSourceRoot)/src/Hexalith.EventStore.ServiceDefaults/Hexalith.EventStore.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
