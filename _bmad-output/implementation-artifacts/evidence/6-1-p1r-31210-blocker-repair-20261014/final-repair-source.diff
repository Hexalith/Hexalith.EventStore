+                "DOCKER_CONFIG": isolation.CLIENT_CONFIG, "PATH": os.defpath, "CUSTOM_FIXTURE": "preserved"}
+
+    def testPrivateEndpointIsFixedAndClientOptionsCannotLeak(self):
