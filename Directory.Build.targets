<Project>

  <!-- Local source graphs must use one EventStore assembly identity across the root and Tenants
       edges. Tenants keeps its own published package pin; this metadata applies only to source refs.
       A verified workspace mapping already reconciles that graph and owns its reserved version inputs. -->
  <ItemGroup Condition="'$(HexalithTenantsFromSource)' == 'true' and '$(HexalithTenantsBasePath)' != '' and '$(HexalithEventStoreVersion)' != '' and '$(HexalithSourceMappingHash)' == '' and '$(HexalithSourceMappingMode)' != 'source' and '$(HEXALITH_SOURCE_MAPPING_HASH)' == '' and '$(HEXALITH_SOURCE_MAPPING_PATH)' == ''">
    <ProjectReference Update="$(HexalithTenantsBasePath)/Hexalith.Tenants*/Hexalith.Tenants*.csproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- The .NET SDK promotes project references after this file's item evaluation. Keep those
       selected Tenants source nodes on this producer too; never rewrite another root or an active mapping. -->
  <Target Name="PreserveEventStoreVersionOnPromotedTenantsSources" AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(HexalithTenantsFromSource)' == 'true' and '$(HexalithTenantsBasePath)' != '' and '$(HexalithEventStoreVersion)' != '' and '$(HexalithSourceMappingHash)' == '' and '$(HexalithSourceMappingMode)' != 'source' and '$(HEXALITH_SOURCE_MAPPING_HASH)' == '' and '$(HEXALITH_SOURCE_MAPPING_PATH)' == ''">
    <PropertyGroup>
      <_EventStoreSelectedTenantsSourceRoot>$([MSBuild]::NormalizeDirectory('$(HexalithTenantsBasePath)'))</_EventStoreSelectedTenantsSourceRoot>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'%(ProjectReference.Extension)' == '.csproj' and $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(_EventStoreSelectedTenantsSourceRoot)')) and ('%(ProjectReference.NuGetPackageId)' == 'Hexalith.Tenants' or $([System.String]::Copy('%(ProjectReference.NuGetPackageId)').StartsWith('Hexalith.Tenants.')) or ('%(ProjectReference.NuGetPackageId)' == '' and ('%(ProjectReference.Filename)' == 'Hexalith.Tenants' or $([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('Hexalith.Tenants.')))))">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!--
    Container image defaults (.NET SDK container support).
    Opt-in per project with:
      <EnableContainer>true</EnableContainer>
      <ContainerRepository>image-name</ContainerRepository>
    CI/CD may override ContainerRegistry via env or -p:. The image tag is not free:
    it must equal ContainerProvenanceReleaseVersion, and defaults to it when unset.
    Loaded as .targets (post-project) so EnableContainer set in the project is visible.
  -->
  <PropertyGroup Condition="'$(EnableContainer)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0-alpine</ContainerBaseImage>
    <ContainerFamily>alpine</ContainerFamily>
    <ContainerRegistry Condition="'$(ContainerRegistry)' == ''">registry.hexalith.com</ContainerRegistry>
    <ContainerImageTag Condition="'$(ContainerImageTags)' == '' and '$(ContainerImageTag)' == ''">$(ContainerProvenanceReleaseVersion)</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
    <!--
      The .NET SDK 10.0.x multi-RID target serializes labels as key:value and
      reconstructs them with String.Split(':')[1] (observed on 10.0.302 and
      10.0.303). Every value containing a colon is truncated at the first one:
      URLs collapse to "https" and RFC 3339 timestamps to their date-and-hour
      prefix. These publisher-owned inputs are rebound after the SDK parse
      target below so both child configs retain the exact release identity.
    -->
    <ContainerGenerateLabelsImageSource>false</ContainerGenerateLabelsImageSource>
    <ContainerGenerateLabelsImageUrl>false</ContainerGenerateLabelsImageUrl>
    <ContainerGenerateLabelsImageDocumentation>false</ContainerGenerateLabelsImageDocumentation>
    <ContainerGenerateLabelsImageRevision>false</ContainerGenerateLabelsImageRevision>
    <ContainerGenerateLabelsImageVersion>false</ContainerGenerateLabelsImageVersion>
    <ContainerGenerateLabelsImageCreated>false</ContainerGenerateLabelsImageCreated>
    <!--
      Release and documentation URLs default to the published tag and source README.
      ContainerProvenanceCreated deliberately has no default: it must be
      one publisher-owned instant shared by both child configs, and an MSBuild-local
      fallback is re-evaluated independently by the SDK's inner RID builds, so the
      children would disagree. The validation target below fails closed when it is
      absent; the pinned publisher contract test proves the publisher supplies it.
    -->
    <ContainerProvenanceRepositoryUrl Condition="'$(ContainerProvenanceRepositoryUrl)' == ''">https://github.com/Hexalith/Hexalith.EventStore</ContainerProvenanceRepositoryUrl>
    <ContainerProvenanceReleaseUrl Condition="'$(ContainerProvenanceReleaseUrl)' == ''">$(ContainerProvenanceRepositoryUrl)/releases/tag/v$(ContainerProvenanceReleaseVersion)</ContainerProvenanceReleaseUrl>
    <ContainerProvenanceDocumentationUrl Condition="'$(ContainerProvenanceDocumentationUrl)' == ''">$(ContainerProvenanceRepositoryUrl)/blob/$(ContainerProvenanceSourceSha)/README.md</ContainerProvenanceDocumentationUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableContainer)' == 'true'">
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="$(ContainerProvenanceRepositoryUrl)" />
    <ContainerLabel Include="org.opencontainers.image.url" Value="$(ContainerProvenanceReleaseUrl)" />
    <ContainerLabel Include="org.opencontainers.image.documentation" Value="$(ContainerProvenanceDocumentationUrl)" />
    <ContainerLabel Include="org.opencontainers.image.revision" Value="$(ContainerProvenanceSourceSha)" />
    <ContainerLabel Include="org.opencontainers.image.version" Value="$(ContainerProvenanceReleaseVersion)" />
    <ContainerLabel Include="org.opencontainers.image.created" Value="$(ContainerProvenanceCreated)" />
    <ContainerLabel Include="org.opencontainers.artifact.created" Value="$(ContainerProvenanceCreated)" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="MIT" />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="Hexalith" />
  </ItemGroup>

  <Target Name="ValidateContainerProvenanceInputs"
          BeforeTargets="_PublishMultiArchContainers;_PublishSingleContainer"
          Condition="'$(EnableContainer)' == 'true'">
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceSourceSha)', '^[0-9a-f]{40}$')) != 'true'"
           Text="ContainerProvenanceSourceSha must be an exact lowercase 40-character commit SHA." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceReleaseVersion)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.((0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$')) != 'true'"
           Text="ContainerProvenanceReleaseVersion must be SemVer without build metadata or leading-zero numeric identifiers." />
    <Error Condition="'$(ContainerImageTag)' != '' and '$(ContainerImageTag)' != '$(ContainerProvenanceReleaseVersion)'"
           Text="ContainerImageTag must equal ContainerProvenanceReleaseVersion." />
    <Error Condition="'$(ContainerImageTags)' != '' and '$(ContainerImageTags)' != '$(ContainerProvenanceReleaseVersion)'"
           Text="ContainerImageTags must be exactly ContainerProvenanceReleaseVersion and nothing else." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceCreated)', '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$')) != 'true'"
           Text="ContainerProvenanceCreated must be an exact UTC RFC 3339 second." />
    <!-- Validate the effective properties, including explicit and environment overrides. -->
    <Error Condition="$([System.String]::Equals('$(ContainerProvenanceRepositoryUrl)', 'https://github.com/Hexalith/Hexalith.EventStore')) != 'true'"
           Text="ContainerProvenanceRepositoryUrl must be the canonical EventStore repository URL." />
    <!-- The source commit URL also identifies local images without a published release tag. -->
    <Error Condition="$([System.String]::Equals('$(ContainerProvenanceReleaseUrl)', '$(ContainerProvenanceRepositoryUrl)/releases/tag/v$(ContainerProvenanceReleaseVersion)')) != 'true' and $([System.String]::Equals('$(ContainerProvenanceReleaseUrl)', '$(ContainerProvenanceRepositoryUrl)/commit/$(ContainerProvenanceSourceSha)')) != 'true'"
           Text="ContainerProvenanceReleaseUrl must identify the declared release tag or source commit in the EventStore repository." />
    <Error Condition="$([System.String]::Equals('$(ContainerProvenanceDocumentationUrl)', '$(ContainerProvenanceRepositoryUrl)/blob/$(ContainerProvenanceSourceSha)/README.md')) != 'true'"
           Text="ContainerProvenanceDocumentationUrl must identify README.md at the declared EventStore source commit." />
  </Target>

  <!-- Correct the SDK multi-RID key:value reconstruction before the child image is created. -->
  <Target Name="RebindContainerProvenanceLabels"
          AfterTargets="_ParseItemsForPublishingSingleContainer"
          Condition="'$(EnableContainer)' == 'true' and '$(_IsSingleRIDBuild)' == 'true'">
    <ItemGroup>
      <ContainerLabel Remove="org.opencontainers.image.source;org.opencontainers.image.url;org.opencontainers.image.documentation;org.opencontainers.image.revision;org.opencontainers.image.version;org.opencontainers.image.created;org.opencontainers.artifact.created" />
      <ContainerLabel Include="org.opencontainers.image.source" Value="$(ContainerProvenanceRepositoryUrl)" />
      <ContainerLabel Include="org.opencontainers.image.url" Value="$(ContainerProvenanceReleaseUrl)" />
      <ContainerLabel Include="org.opencontainers.image.documentation" Value="$(ContainerProvenanceDocumentationUrl)" />
      <ContainerLabel Include="org.opencontainers.image.revision" Value="$(ContainerProvenanceSourceSha)" />
      <ContainerLabel Include="org.opencontainers.image.version" Value="$(ContainerProvenanceReleaseVersion)" />
      <ContainerLabel Include="org.opencontainers.image.created" Value="$(ContainerProvenanceCreated)" />
      <ContainerLabel Include="org.opencontainers.artifact.created" Value="$(ContainerProvenanceCreated)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveOpenApiXmlCommentSourceGenerator" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.AspNetCore.OpenApi'" />
    </ItemGroup>
  </Target>

  <!-- Explicit EventStore selections stay authoritative. The catalog file text is only
       the default used when HexalithEventStoreVersion was not supplied. -->
  <Target Name="ValidateHexalithEventStoreSelection" BeforeTargets="CollectPackageReferences" Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <ItemGroup>
      <_HexalithEventStoreDependency Include="@(PackageReference)" Condition="$([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Hexalith.EventStore.', System.StringComparison.OrdinalIgnoreCase))" />
      <_HexalithEventStoreRow Include="@(PackageVersion)" Condition="$([System.String]::Copy('%(PackageVersion.Identity)').StartsWith('Hexalith.EventStore.', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_HexalithEventStoreDependency)' != '' and '%(_HexalithEventStoreRow.Version)' != '$(HexalithEventStoreVersion)'"
           Text="$(MSBuildProjectName) selects %(_HexalithEventStoreRow.Identity) %(_HexalithEventStoreRow.Version). Restore EventStore $(HexalithEventStoreVersion)." />
  </Target>
  <Target Name="ValidateHexalithEventStoreReferences" AfterTargets="ResolveReferences"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <!-- The SDK can also put package identity and the producer version on transitive project outputs. -->
      <_HexalithResolvedEventStore Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' != 'ProjectReference' and $([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Hexalith.EventStore.', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Error Condition="'@(_HexalithResolvedEventStore)' != '' and '%(_HexalithResolvedEventStore.NuGetPackageVersion)' != '$(HexalithEventStoreVersion)'"
           Text="$(MSBuildProjectName) resolved %(_HexalithResolvedEventStore.NuGetPackageId) %(_HexalithResolvedEventStore.NuGetPackageVersion). The selected EventStore version is $(HexalithEventStoreVersion)." />
  </Target>

  <!-- Package consumers need the same generator selection as source-catalog builds. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(MSBuildProjectName)' != 'Hexalith.EventStore.RestApi.Generators'">
    <None Include="$(MSBuildThisFileDirectory)buildTransitive/Hexalith.EventStore.Logging.targets"
          Pack="true" PackagePath="buildTransitive/$(MSBuildProjectName).targets" Visible="false" />
  </ItemGroup>

</Project>
