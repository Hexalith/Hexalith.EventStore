  ${V("inline-flex")}

  :host {
    --duration: 1.5s;
    --indicatorSize: ${Ct};
    --size: 32px;
    height: var(--size);
    width: var(--size);
    contain: strict;
    content-visibility: auto;
  }

  :host([size='tiny']) {
