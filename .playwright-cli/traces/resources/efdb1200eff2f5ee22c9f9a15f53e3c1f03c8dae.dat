  ${V("block")}

  :host {
    outline: none;
    font-size: ${re};
    line-height: ${ce};
  }

  :host(:focus-visible) .positioning-region {
    box-shadow: ${ts} ${ts} ${ts} ${an}
      ${Be} inset;
  }

  /**
   * Default variants:
   * Size - medium
   * Appearance - subtle
   */
  .positioning-region {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    height: ${Gm};
    padding-inline-start: calc(var(--indent) * ${nn});
    padding-inline-end: ${ze};
    border-radius: ${X};
    background-color: ${Ba};
    color: ${et};
    gap: ${$e};
  }

  @media (prefers-contrast: more) {
    :host(:focus-visible) .positioning-region {
      outline: 1px solid ${Be};
    }
  }

  .content {
    display: flex;
    align-items: center;
    gap: ${$e};
  }

  .chevron {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    justify-content: center;
    width: ${nn};
    height: ${er};
    transition: transform ${sn} ${rs};
    transform: rotate(0deg);
  }

  .chevron:dir(rtl) {
    transform: rotate(180deg);
  }

  .chevron svg {
    inline-size: 12px;
    block-size: 12px;
  }

  .aside {
    display: flex;
    align-items: center;
  }

  .positioning-region:hover {
    background-color: ${fr};
    color: ${Qt};
  }

  .positioning-region:active {
    background-color: ${Qo};
    color: ${Jt};
  }

  ::slotted([slot='start']),
  ::slotted([slot='end']),
  ::slotted(:not([slot])) {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  ::slotted([slot='start']) {
    flex-shrink: 0;
  }

  ::slotted(:not([slot])) {
    padding-inline: ${we};
  }

  .items {
    display: none;
  }

  :host([expanded]) .items {
    display: block;
  }

  :host([empty]) .chevron,
  :host([empty]) .items {
    visibility: hidden;
  }

  :host([selected]) .positioning-region {
    background-color: ${wa};
    color: ${An};
  }

  :host([selected]) .content,
  :host([selected]) .chevron {
    color: ${eh};
  }

  :host([size='small']) .positioning-region {
    height: ${er};
    padding-inline-start: calc(var(--indent) * ${Ie});
  }

  :host([appearance='subtle-alpha']) .positioning-region:hover {
    background-color: ${gh};
  }

  :host([appearance='subtle-alpha']) .positioning-region:active {
    background-color: ${fh};
  }

  :host([appearance='subtle-alpha'][selected]) .positioning-region {
    background-color: ${bh};
    color: ${An};
  }

  :host([appearance='transparent']) .positioning-region {
    background-color: ${Xe};
  }

  :host([appearance='transparent']) .positioning-region:hover {
    background-color: ${tn};
  }

  :host([appearance='transparent']) .positioning-region:active {
    background-color: ${on};
  }

  :host([appearance='transparent'][selected]) .positioning-region {
    background-color: ${$a};
    color: ${An};
  }

  :host([expanded]) .chevron {
    transform: rotate(90deg);
  }
