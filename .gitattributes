* text=auto
# .editorconfig sets end_of_line = crlf for [*], so an EditorConfig-honouring editor rewrites
# C# sources to CRLF while `text=auto` keeps the index at LF. That drift is invisible to
# `git status` and breaks source-inspection tests that match newline-bearing markers.
*.cs text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
# Dapr broker qualification inputs are bound by SHA-256 in runtime-lock.json.
deploy/dapr/qualification/** text eol=lf
# Public runtime identities (OCI indexes, pinned sources, chart archive) keep exact bytes.
deploy/dapr/qualification/public-identities/** -text
.github/workflows/dapr-broker-qualification.yml text eol=lf
commitlint.config.mjs text eol=lf
# Husky hooks execute through /bin/sh and must not acquire CRLF line endings.
.husky/* text eol=lf
*.nupkg binary
global.json text eol=crlf
