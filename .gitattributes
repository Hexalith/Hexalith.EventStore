* text=auto
# .editorconfig sets end_of_line = crlf for [*], so an EditorConfig-honouring editor rewrites
# C# sources to CRLF while `text=auto` keeps the index at LF. That drift is invisible to
# `git status` and breaks source-inspection tests that match newline-bearing markers.
*.cs text eol=lf
*.md text eol=lf
*.sh text eol=lf
# The release-evidence verifiers are pinned by SHA-256 inside subject.json and closure.json, so the
# same CRLF drift silently invalidates the canonical subject on a clean worktree. Python sources
# carried only `text=auto`, which leaves the working-tree ending to the editor.
*.py text eol=lf
commitlint.config.mjs text eol=lf
# Husky hooks execute through /bin/sh and must not acquire CRLF line endings.
.husky/* text eol=lf
*.nupkg binary
# Story 1.21 hashes canonical evidence bytes; keep those JSON and checksum artifacts LF-stable.
_bmad-output/implementation-artifacts/evidence/story-1-21/*.json text eol=lf
_bmad-output/implementation-artifacts/evidence/story-1-21/*.txt text eol=lf
# Story 3.13 hash-binds its raw OCI objects and registry/tag responses through
# identity-crosswalk.json exactly as 3.14 and 3.15 do, and was missing these rules.
_bmad-output/implementation-artifacts/evidence/story-3-13/** text eol=lf
_bmad-output/implementation-artifacts/evidence/story-3-13/**/*.nupkg binary
_bmad-output/implementation-artifacts/evidence/story-3-13/**/*.raw binary
# Story 3.14 binds every packet file by exact SHA-256 and retains the codec that verifies them.
