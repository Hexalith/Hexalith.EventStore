@page "/pattern-silent-reload"
@using Microsoft.FluentUI.AspNetCore.Components
@using Hexalith.EventStore.Client.Gateway
@using Hexalith.EventStore.Sample.Counter.Queries
@using Hexalith.EventStore.Sample.BlazorUI.Services
@inject EventStoreSignalRClient SignalRClient
@inject EventStoreProjectionQueryClient QueryClient
@inject IConfiguration Configuration
@implements IAsyncDisposable

<!-- Pattern 2: Automatic Silent Reload
     Trade-offs:
     + Refreshes seamlessly after received signals without user intervention
     + Simple to implement — just re-fetch on each received signal
     - May cause layout shifts if data size changes
     - Higher query load — every signal triggers a fetch
     - User may lose scroll position or selection state
     Best for: Real-time monitoring, simple data views, counter displays -->

<h1>Pattern 2: Automatic Silent Reload</h1>
<p>
    Data refreshes automatically when this page receives counter projection change signals.
    A subtle fade transition indicates the update — no user action required.
</p>

<FluentCard Style="max-width: 400px; padding: 24px;">
    <h2>Counter Value</h2>
    @if (_error is not null)
    {
        <Microsoft.FluentUI.AspNetCore.Components.FluentMessageBar Title="Error" Intent="MessageBarIntent.Error" Style="margin-bottom: 12px;">
            @_error
        </Microsoft.FluentUI.AspNetCore.Components.FluentMessageBar>
    }
    @if (_result is not null)
    {
        <div style="transition: opacity 0.3s ease; opacity: @(_isRefreshing ? "0.5" : "1");">
            <p style="font-size: 48px; font-weight: bold; margin: 16px 0;">@_result.Count</p>
        </div>
        <p style="color: var(--neutral-foreground-hint);">
            Last updated: @_lastRefreshed?.ToString("HH:mm:ss")
        </p>
        @if (_result.ETag is not null)
        {
            <p style="color: var(--neutral-foreground-hint); font-size: 12px;">
                ETag: @_result.ETag[..Math.Min(8, _result.ETag.Length)]...
            </p>
        }
        <p style="color: var(--neutral-foreground-hint); font-size: 12px;">
            Refresh count: @_refreshCount
        </p>
    }
    else if (_error is null)
    {
        <p>Loading...</p>
    }
</FluentCard>

<CounterCommandForm TenantId="@_tenantId" />

@code {
    private readonly CounterRefreshLifetime _refresh = new();

    // 200ms balances responsiveness vs. query coalescing — increase for high-frequency projections
    private const int DebounceDelayMs = 200;

    private string _tenantId = "tenant-a";
    private string _projectionType = "counter";
    private CounterStatusResult? _result;
    private DateTime? _lastRefreshed;
    private bool _isRefreshing;
    private int _refreshCount;
    private string? _error;
    private CancellationTokenSource? _debounceCts;
    private long _notificationVersion;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = Configuration["EventStore:Counter:TenantId"] ?? "sample-tenant";
        _projectionType = Configuration["EventStore:Counter:ProjectionType"] ?? "counter";

        await _refresh.RunAsync(async token =>
        {
            if (RendererInfo.IsInteractive)
            {
                await SignalRClient.SubscribeAsync(_projectionType, _tenantId, OnProjectionChanged, token);
            }

            await LoadDataAsync(token);
        });
    }

    private void OnProjectionChanged()
    {
        if (!_refresh.IsDisposed)
        {
            _ = InvokeAsync(DebounceRefreshAsync);
        }
    }

    private async Task DebounceRefreshAsync()
    {
        if (_refresh.IsDisposed)
        {
            return;
        }

        long version = ++_notificationVersion;
        _debounceCts?.Cancel();
        using var debounce = new CancellationTokenSource();
        _debounceCts = debounce;
        try
        {
            await Task.Delay(DebounceDelayMs, debounce.Token);
        }
        catch (OperationCanceledException) when (debounce.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (_debounceCts == debounce)
            {
                _debounceCts = null;
            }
        }

        if (version == _notificationVersion)
        {
            await _refresh.RunAsync(token => version == _notificationVersion ? RefreshDataAsync(token) : Task.CompletedTask);
        }
    }

    private async Task RefreshDataAsync(CancellationToken token)
    {
        _isRefreshing = true;
        StateHasChanged();

        await LoadDataAsync(token);
        if (!token.IsCancellationRequested)
        {
            _isRefreshing = false;
            _refreshCount++;
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync(CancellationToken token)
    {
        try
        {
            token.ThrowIfCancellationRequested();
            EventStoreQueryResult queryResult = await QueryClient.GetAsync(
                _tenantId,
                GetCounterStatusQuery.Domain,
                "counter-1",
                GetCounterStatusQuery.QueryType,
                GetCounterStatusQuery.ProjectionType,
                "counter-1",
                _result?.ETag,
                token);
            token.ThrowIfCancellationRequested();
            if (!CounterStatusResult.TryFromQueryResult(queryResult, _result, out CounterStatusResult state))
            {
                _error = CounterStatusResult.InvalidPayloadMessage;
                return;
            }

            _result = state;
            _lastRefreshed = DateTime.Now;
            _error = null;
        }
        catch (Exception) when (token.IsCancellationRequested)
        {
        }
        catch (EventStoreGatewayException ex) when (CounterQueryFailure.IsProjectionNotYetAvailable(ex))
        {
            _result = CounterStatusResult.Empty;
            _lastRefreshed = DateTime.Now;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load counter: {CounterQueryFailure.Describe(ex)}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _refresh.Dispose();
        _debounceCts?.Cancel();
        if (RendererInfo.IsInteractive)
        {
            await SignalRClient.UnsubscribeAsync(_projectionType, _tenantId, OnProjectionChanged);
        }
    }
}
