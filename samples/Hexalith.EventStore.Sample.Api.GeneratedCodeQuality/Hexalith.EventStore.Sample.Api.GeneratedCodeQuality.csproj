<Project Sdk="Microsoft.NET.Sdk">

  <!-- Story 2.17 (NFR13/OR26) generated-code conformance gate. Analyzers skip `<auto-generated />`
       trees, so this non-packable library compiles byte-for-byte copies of Sample.Api's emitted
       REST-generator files as ordinary code (sibling .editorconfig: generated_code = false). The
       repository compiler, .NET analyzer (for example CA2007) and IDE code-style rules then run on
       the generated controller inside CI's Release -warnaserror solution build. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.EventStore.Sample.Contracts\Hexalith.EventStore.Sample.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.EventStore.Client\Hexalith.EventStore.Client.csproj" Condition="'$(HexalithUsePublishedSdkForHostedTests)' != 'true'" />
    <!-- Build order only: Sample.Api must emit its generated files before they are copied. -->
    <ProjectReference Include="..\Hexalith.EventStore.Sample.Api\Hexalith.EventStore.Sample.Api.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- Explicit integration-fixture profile; keeps one Contracts identity beside the Sample.Contracts package edge. -->
  <ItemGroup Condition="'$(HexalithUsePublishedSdkForHostedTests)' == 'true'">
    <PackageReference Include="Hexalith.EventStore.Client" />
  </ItemGroup>

  <!-- Copies only the REST-generator *.g.cs files Sample.Api emitted for this configuration, unchanged,
       and compiles them under the repository .editorconfig files that govern the copy location. -->
  <Target Name="IncludeSampleApiRestGeneratedSources"
          BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SampleApiRestGeneratorOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'Hexalith.EventStore.Sample.Api', 'obj', '$(Configuration)', '$(TargetFramework)', 'generated', 'Hexalith.EventStore.RestApi.Generators', 'Hexalith.EventStore.RestApi.Generators.RestApiGenerator'))</_SampleApiRestGeneratorOutputDirectory>
      <_SampleApiRestGeneratedCopyDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'SampleApiRestGenerated'))</_SampleApiRestGeneratedCopyDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_SampleApiRestGeneratedSource Include="$(_SampleApiRestGeneratorOutputDirectory)*.g.cs" />
      <_SampleApiRestGeneratedController Include="$(_SampleApiRestGeneratorOutputDirectory)*.Controller.g.cs" />
    </ItemGroup>

    <Error Condition="'@(_SampleApiRestGeneratedSource)' == ''"
           Text="Sample.Api produced no REST-generator *.g.cs files in '$(_SampleApiRestGeneratorOutputDirectory)'. The generated-code conformance gate needs Sample.Api built in the '$(Configuration)' configuration with EmitCompilerGeneratedFiles=true." />
    <Error Condition="'@(_SampleApiRestGeneratedController)' == ''"
           Text="Sample.Api produced no REST-generator *.Controller.g.cs file in '$(_SampleApiRestGeneratorOutputDirectory)'. The generated-code conformance gate has no controller to check." />

    <Copy SourceFiles="@(_SampleApiRestGeneratedSource)"
          DestinationFolder="$(_SampleApiRestGeneratedCopyDirectory)"
          SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="_SampleApiRestGeneratedCopy" />
    </Copy>

    <ItemGroup>
      <Compile Include="@(_SampleApiRestGeneratedCopy)" />
      <FileWrites Include="@(_SampleApiRestGeneratedCopy)" />

      <!-- Roslyn discovers .editorconfig files from evaluation-time Compile items only; add the ones above the copies. -->
      <_SampleApiRestGeneratedDirectoryAbove Include="@(_SampleApiRestGeneratedCopy->GetPathsOfAllDirectoriesAbove())" />
      <_SampleApiRestGeneratedEditorConfig Include="@(_SampleApiRestGeneratedDirectoryAbove->'%(FullPath)'->Distinct()->Combine('.editorconfig')->Exists())" />
      <EditorConfigFiles Remove="@(_SampleApiRestGeneratedEditorConfig)" />
      <EditorConfigFiles Include="@(_SampleApiRestGeneratedEditorConfig)" />
    </ItemGroup>
  </Target>

</Project>
